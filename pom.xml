<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.5</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.hoseacodes</groupId>
	<artifactId>emailintegrator</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>emailintegrator</name>
	<description>Email services</description>
	<properties>
		<java.version>17</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-vault-config</artifactId>
			<version>4.1.1</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.3</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.3</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.13.0</version>
			<scope>runtime</scope>
		</dependency>

		<!--
			Bean Validation (Hibernate Validator). Required for @Valid/@NotBlank/@Email on
			request DTOs. jakarta.validation-api arrives transitively via swagger-core, but
			without this starter there is no implementation and the annotations are inert.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!--
			Spring Security. Before this, every endpoint was reachable anonymously — including
			/auth/manual-approve and /auth/send-email, which are documented as administrative and
			which send mail from a real, reputation-bearing domain. See ENGINEERING_AUDIT CRIT-1.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			Declared explicitly, not relied on transitively. Spring's ClientHttpRequestFactories
			auto-selects whichever HTTP client happens to be on the classpath, so the outbound
			client — and its defaults — would otherwise be decided by an unrelated dependency.

			This matters more than usual here: Apache HttpClient 5 retries automatically by
			default, including on 429 and 503 where it honours Retry-After and sleeps. Applied to
			a non-idempotent email send, that silently delivers duplicate messages. The retry
			behaviour is disabled explicitly in BrevoClientConfig and asserted in
			BrevoEmailProviderTest. Version is managed by the Spring Boot parent.
		-->
		<dependency>
			<groupId>org.apache.httpcomponents.client5</groupId>
			<artifactId>httpclient5</artifactId>
		</dependency>

		<!-- Swagger/OpenAPI UI for Spring Boot -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.1.0</version>
		</dependency>

		<!--
			WireMock runs a real HTTP server on localhost so integration tests can exercise
			provider failure modes (429, 5xx, timeouts, malformed bodies) that cannot be
			reproduced against the live Brevo API. The 'standalone' artifact is shaded, which
			avoids clashes between WireMock's Jetty and Spring Boot's embedded Tomcat.
		-->
		<dependency>
			<groupId>org.wiremock</groupId>
			<artifactId>wiremock-standalone</artifactId>
			<version>3.13.2</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!--
		Removed 2026-08-07: com.sendinblue:sib-api-v3-sdk:7.0.0 and its com.squareup.okio pin.
		The SDK dragged Maven 2.0.6 build tooling (maven-project, maven-gpg-plugin,
		wagon-provider-api:1.0-beta-2) onto the runtime classpath, authenticated through
		global static state (Configuration.getDefaultApiClient()) that could not be isolated
		in tests, and offered no way to configure connect/read timeouts. Brevo's transactional
		send is a single POST, so it is called directly via RestClient instead.
		See docs/adr/0001-brevo-http-client-over-vendor-sdk.md.
	-->

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!--
						Integration tests here bind real sockets and exercise timeout behaviour. A
						bug in that code can hang the fork rather than fail it, which in CI looks
						like a stalled job until the whole workflow times out. This bounds the fork
						so a hang surfaces as a test failure with a stack trace instead.
					-->
					<forkedProcessTimeoutInSeconds>300</forkedProcessTimeoutInSeconds>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
