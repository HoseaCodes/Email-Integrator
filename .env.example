# Email Integrator — environment configuration template
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored and must never be committed.
#
# Spring Boot does NOT read .env files on its own — there is no dotenv dependency. Export the
# values into the environment before starting the app:
#
#   set -a && . ./.env && set +a && ./mvnw spring-boot:run
#
# or pass the file to Docker:
#
#   docker run --env-file .env -p 8080:8080 hoseacodes-emailintegrator
#
# Every value below is REQUIRED. The application deliberately fails to start if one is missing
# rather than booting into a state where it would accept traffic it cannot serve safely.


# ---------------------------------------------------------------------------------------------
# API authentication  (app.security.api-keys.default)
# ---------------------------------------------------------------------------------------------
# The credential callers present in the X-API-Key header. Minimum 32 characters; startup fails
# below that. There is no default — a default would mean a deployment that forgot to configure
# credentials would come up accepting a publicly known secret.
#
#   Generate:  openssl rand -base64 32
#
# Add more clients as APP_SECURITY_APIKEYS_<NAME> so each integration has its own revocable key.
API_KEY_DEFAULT=replace-me-with-openssl-rand-base64-32-output


# ---------------------------------------------------------------------------------------------
# Brevo transactional email  (brevo.api-key)
# ---------------------------------------------------------------------------------------------
# From the Brevo dashboard: Settings → SMTP & API → API Keys. Real keys start with "xkeysib-".
# Used by POST /email. Never logged and never returned in a response.
BREVO_API_KEY=xkeysib-replace-me-with-your-real-brevo-api-key


# ---------------------------------------------------------------------------------------------
# JWT signing key for approval links  (app.jwt.secret)
# ---------------------------------------------------------------------------------------------
# Signs the one-time approval/deny links emailed to an administrator. Anyone who knows this can
# forge an approval for any address, so treat it as a production secret.
#
# HS256 requires at least 256 bits (32 bytes).
#   Generate:  openssl rand -base64 32
JWT_SECRET=replace-me-with-openssl-rand-base64-32-output


# ---------------------------------------------------------------------------------------------
# Gmail SMTP  (spring.mail.password)
# ---------------------------------------------------------------------------------------------
# A Google *app password*, not the account password. Requires 2FA on the account:
#   Google Account → Security → 2-Step Verification → App passwords
#
# An app password bypasses 2FA entirely — rotate it if it is ever exposed, including in shell
# history or a backup file.
MAIL_PASSWORD=replace-me-with-a-16-character-google-app-password


# ---------------------------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------------------------
# Restrict which hosts caller-supplied links in outgoing email may point at. Strongly
# recommended: without it, a client holding a valid API key can have this service send a
# password-reset email, from your domain, linking to a host they control.
# Comma-separated, exact host match.
# APP_EMAIL_ALLOWEDLINKHOSTS=app.example.com,portal.example.com

# Point the Brevo client at a local stub instead of the real API during development.
# BREVO_BASE_URL=http://localhost:8089

# Disable outbound sending entirely while still exercising validation and error handling.
# APP_EMAIL_ENABLED=false
